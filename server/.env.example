# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hermes agent on the team VPS (OpenAI-compatible API). Ask the team for the key; never commit it.
HERMES_BASE_URL=
HERMES_API_KEY=

# Shared access code for the gated routes (HTTP Basic password). Unset: those routes answer 503.
ACCESS_CODE=

# Comma-separated lists. Defaults shown; set both on the VPS.
# APP_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# ALLOWED_HOSTS=localhost,127.0.0.1
# An explicitly empty APP_ORIGINS allows no origin at all: every POST that sends an Origin gets 403.
