  "components": [
    {
      "name": "Lesson",
      "description": "The root of every page. Its children are the blocks in reading order. Use it exactly once.",
      "props": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "Chunk",
      "description": "One short, self-contained piece of the material: a clear heading and at most 3 short sentences. Use many Chunks instead of one long text.",
      "props": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "The exact sentence(s) from the student material this block is based on, copied word for word."
          }
        },
        "required": [
          "heading",
          "text",
          "source"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "Flashcard",
      "description": "A term or question on the front, the answer on the back. For retrieval practice of facts and vocabulary.",
      "props": {
        "type": "object",
        "properties": {
          "front": {
            "type": "string"
          },
          "back": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "The exact sentence(s) from the student material this block is based on, copied word for word."
          }
        },
        "required": [
          "front",
          "back",
          "source"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "Quiz",
      "description": "A multiple choice question with immediate feedback. Checks understanding right after a few Chunks.",
      "props": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "minItems": 2,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Index of the correct option, starting at 0."
          },
          "explanation": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "The exact sentence(s) from the student material this block is based on, copied word for word."
          }
        },
        "required": [
          "question",
          "options",
          "answer",
          "explanation",
          "source"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ReadAloud",
      "description": "Text the student can listen to with one tap (browser speech). For students who struggle with reading.",
      "props": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "The exact sentence(s) from the student material this block is based on, copied word for word."
          }
        },
        "required": [
          "text",
          "source"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "Steps",
      "description": "An ordered process or sequence, one short step at a time. For anything that happens in order.",
      "props": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "steps": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "source": {
            "type": "string",
            "description": "The exact sentence(s) from the student material this block is based on, copied word for word."
