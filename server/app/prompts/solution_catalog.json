          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "Lesson",
                "Chunk",
                "Flashcard",
                "Quiz",
                "ReadAloud",
                "Steps"
              ]
            },
            "props": {
              "type": "object",
              "additionalProperties": {}
            },
            "children": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
